{
  "name": "godot-open-mcp-cli",
  "version": "0.0.1",
  "description": "Command-line tooling for Godot Open MCP — install, setup-mcp, open, wait-for-ready, status, configure.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "godot-open-mcp-cli": "bin/godot-open-mcp-cli.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test 'dist-test/**/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "godot",
    "godot4",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "setup"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": "Godot Open MCP",
  "homepage": "https://github.com/AlexeyPerov/Godot-Open-MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexeyPerov/Godot-Open-MCP.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/AlexeyPerov/Godot-Open-MCP/issues"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "~5.6.2"
  }
}
