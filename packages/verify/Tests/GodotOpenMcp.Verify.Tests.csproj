<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verify unit tests (P3.1). A plain xUnit assembly, NOT a Godot.NET.Sdk game project — same pattern
    as the bridge tests (packages/bridge/Tests). The verify package's contract types (Core/ + Fixes/)
    are pure-managed (no Godot API), so they compile into the binary-less test host directly. Only the
    runner + logging seam (VerifyRunner, VerifyLog) are editor-only `#if TOOLS`, so this project
    defines TOOLS to compile them in — same convention the bridge tests use for MainThreadDispatcher.

    GodotSharp is referenced for compilation only: VerifyLog calls GD.Print / GD.PushWarning /
    GD.PushError. None of those native calls execute in these tests — the fixture swaps the log sinks
    to no-ops via VerifyLog.SetLoggersForTests (mirrors the bridge's BridgeLog seam) so the thrown-rule
    / slow-checkpoint warning paths never P/Invoke into native Godot. VerifyRunner is exercised through
    stub rules that never touch the editor, so no live Godot node is constructed.

    The verify package is standalone (no bridge dependency — packages/verify/AGENTS.md). This project
    has no ProjectReference to the bridge and no compile link to any bridge source, which makes the
    "compiles independently from bridge" acceptance criterion a build-time fact, not just an assertion.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GodotOpenMcp.Verify.Tests</RootNamespace>
    <AssemblyName>GodotOpenMcp.Verify.Tests</AssemblyName>
    <!-- Compile the runner's `#if TOOLS` body. TOOLS is the Godot C# convention for editor-only
         code; the verify assembly sets it via Godot.NET.Sdk, and this test assembly sets it
         explicitly to match — same as packages/bridge/Tests. -->
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
    <!-- Roll forward to the latest available .NET 8+ runtime (matches the bridge test csproj). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    GodotSharp pinned to match the addon's Godot.NET.Sdk/4.3.0 floor (architecture.md: v1 requires
    Godot 4.3+ mono / .NET 8). Only VerifyLog touches it, and only on the GD.* default sinks that the
    tests never reach (swapped to no-ops). The verify sources are compiled directly into this test
    assembly (Link paths mirror the source tree) — no ProjectReference to a Godot.NET.Sdk game project,
    so this stays a plain, CI-friendly xUnit build.
  -->
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.3.0" />
  </ItemGroup>

  <!--
    Compile the verify sources directly (Link paths mirror the source tree). The pure-managed contract
    types (Core/VerifyRunMode, VerifySeverity, VerifyScope, VerifyIssue, IssueKey, IVerifyRule,
    VerifyResult, CheckpointFingerprint; Fixes/FixProviderRegistry) have no Godot API surface and no
    #if TOOLS guard. The editor-only pieces (Core/VerifyRunner, VerifyLog) are #if TOOLS and GD.*-coupled
    only on the log-seam default sinks; the tests swap those sinks to no-ops so the binary-less host
    never faults.
  -->
  <ItemGroup>
    <Compile Include="..\Editor\Core\VerifyRunMode.cs" Link="Source\VerifyRunMode.cs" />
    <Compile Include="..\Editor\Core\VerifySeverity.cs" Link="Source\VerifySeverity.cs" />
    <Compile Include="..\Editor\Core\VerifyScope.cs" Link="Source\VerifyScope.cs" />
    <Compile Include="..\Editor\Core\VerifyIssue.cs" Link="Source\VerifyIssue.cs" />
    <Compile Include="..\Editor\Core\IssueKey.cs" Link="Source\IssueKey.cs" />
    <Compile Include="..\Editor\Core\IVerifyRule.cs" Link="Source\IVerifyRule.cs" />
    <Compile Include="..\Editor\Core\VerifyResult.cs" Link="Source\VerifyResult.cs" />
    <Compile Include="..\Editor\Core\CheckpointFingerprint.cs" Link="Source\CheckpointFingerprint.cs" />
    <Compile Include="..\Editor\Core\VerifyRunner.cs" Link="Source\VerifyRunner.cs" />
    <Compile Include="..\Editor\VerifyLog.cs" Link="Source\VerifyLog.cs" />
    <Compile Include="..\Editor\Fixes\FixProviderRegistry.cs" Link="Source\FixProviderRegistry.cs" />
    <!-- P3.2 broken-references rule. The rule + parser + resolver-contract are pure-managed (no Godot
         API), so they compile into this binary-less host directly. LiveResourceResolver is #if TOOLS and
         GodotSharp-coupled; TOOLS is defined above so it compiles, but its ResourceLoader/ResourceUID
         calls are never reached in tests — the fixture always injects a fake IResourceResolver through
         the rule's internal constructor. -->
    <Compile Include="..\Editor\Rules\BrokenReferences\IssueCodes.cs" Link="Source\Rules\BrokenReferences\IssueCodes.cs" />
    <Compile Include="..\Editor\Rules\BrokenReferences\IResourceResolver.cs" Link="Source\Rules\BrokenReferences\IResourceResolver.cs" />
    <Compile Include="..\Editor\Rules\BrokenReferences\LiveResourceResolver.cs" Link="Source\Rules\BrokenReferences\LiveResourceResolver.cs" />
    <Compile Include="..\Editor\Rules\BrokenReferences\SceneRefParser.cs" Link="Source\Rules\BrokenReferences\SceneRefParser.cs" />
    <Compile Include="..\Editor\Rules\BrokenReferences\BrokenReferencesRule.cs" Link="Source\Rules\BrokenReferences\BrokenReferencesRule.cs" />
  </ItemGroup>

</Project>
