<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bridge unit tests (P1.2+). A plain xUnit assembly, NOT a Godot.NET.Sdk game project.

    The MainThreadDispatcher source is wrapped in `#if TOOLS`, so this project defines TOOLS to
    compile it in. Constructing a Godot Node faults the binary-less test host, so the dispatcher
    tests exercise the pure-managed buffer/drain lifecycle via the type's internal *ForTests seams
    (mirrors the Godot-MCP reference's MainThreadDispatcherTests). The live Node lifecycle
    (_EnterTree / _Process / _ExitTree wiring) is covered by the headless Godot smoke planned for
    P1.9, not here.

    GodotSharp is referenced for compilation only (the dispatcher extends Godot.Node and calls
    GD.PushWarning/PushError). None of those native calls execute in these tests — the test seams
    never construct the Node and the drain paths route exceptions through try/catch, not GD.* (the
    queue-stall warning and action-thrown error paths are exercised live in the Suite-3 smoke).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GodotOpenMcp.Bridge.Tests</RootNamespace>
    <AssemblyName>GodotOpenMcp.Bridge.Tests</AssemblyName>
    <!-- Compile the dispatcher's `#if TOOLS` body. TOOLS is the Godot C# convention for
         editor-only code; the bridge assembly sets it via Godot.NET.Sdk, and this test assembly
         sets it explicitly to match. -->
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
    <!-- The addon's Godot.NET.Sdk/4.3.0 floor targets net8.0. CI runners and local machines may
         only have a newer .NET runtime installed, so roll forward to the latest available patch+
         minor of a higher major. This keeps the target aligned with the addon floor while letting
         the tests run wherever .NET 8+ is installed. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    GodotSharp pinned to match the addon's Godot.NET.Sdk/4.3.0 floor (architecture.md: v1 requires
    Godot 4.3+ mono / .NET 8). The dispatcher sources are compiled directly into this test assembly
    (no ProjectReference to a Godot.NET.Sdk game project) so this stays a plain, CI-friendly xUnit
    build — same pattern the Godot-MCP reference uses for its binary-less unit host.
  -->
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.3.0" />
  </ItemGroup>

  <!--
    Compile the bridge sources directly (Link paths mirror the source tree). The plugin and the
    live Node lifecycle are editor-boot / Godot-node-coupled and are verified via the headless Godot
    smoke (P1.9), not here. The P1.3 sources compiled here (BridgeBindAddress, BridgeJson,
    BridgeHttpResponse, BridgeLog, BridgeSession, BridgeHttpServer) are pure-managed for the parts
    the unit tests exercise: bind-address decisions, JSON shape, /ping readiness, and the HTTP
    integration test that starts a real HttpListener on a free port. The Godot-API call paths
    (BridgeSession.InitializeForEnable, GD.Print in the listener lifecycle) are never reached by
    the unit tests — the integration test swaps BridgeLog's sinks to no-ops and the session tests
    use the *ForTests seams — so the binary-less host never faults.
  -->
  <ItemGroup>
    <Compile Include="..\Runtime\MainThread\MainThreadDispatcher.cs" Link="Source\MainThreadDispatcher.cs" />
    <Compile Include="..\Editor\Bridge\BridgeBindAddress.cs" Link="Source\BridgeBindAddress.cs" />
    <Compile Include="..\Editor\Bridge\BridgeJson.cs" Link="Source\BridgeJson.cs" />
    <Compile Include="..\Editor\Bridge\BridgeHttpResponse.cs" Link="Source\BridgeHttpResponse.cs" />
    <Compile Include="..\Editor\Bridge\BridgeLog.cs" Link="Source\BridgeLog.cs" />
    <Compile Include="..\Editor\Bridge\BridgeSession.cs" Link="Source\BridgeSession.cs" />
    <Compile Include="..\Editor\Bridge\BridgeHttpServer.cs" Link="Source\BridgeHttpServer.cs" />
    <!-- P1.4 — instance lock + deterministic port resolver. Pure-managed (file I/O + SHA256 only,
         no Godot APIs) so they compile into the binary-less test host alongside the bridge sources.
         BridgeInstanceLock routes its diagnostics through BridgeLog (the same no-op-sink swap the
         HTTP integration test uses) so the warning paths never P/Invoke into native Godot. -->
    <Compile Include="..\Editor\Bridge\InstancePortResolver.cs" Link="Source\InstancePortResolver.cs" />
    <Compile Include="..\Editor\Bridge\BridgeInstanceLock.cs" Link="Source\BridgeInstanceLock.cs" />
    <!-- P2.1 — tool dispatch spine. BridgeRequestBody + BridgeEnvelope + ToolDispatchResult +
         BridgeToolRegistry are pure-managed (no Godot APIs) so they compile into the binary-less
         test host. BridgeHttpServer gains the POST /tools/{name} routing; the dispatch handler
         marshals to the main thread via MainThreadDispatcher, whose IsMainThread fast path lets
         the integration test drive the dispatcher directly (the test runs on the main thread, so
         no queue hop is needed and no live dispatcher Node is required). -->
    <Compile Include="..\Editor\Bridge\BridgeRequestBody.cs" Link="Source\BridgeRequestBody.cs" />
    <Compile Include="..\Editor\Bridge\JsonBody.cs" Link="Source\JsonBody.cs" />
    <Compile Include="..\Editor\Bridge\BridgeEnvelope.cs" Link="Source\BridgeEnvelope.cs" />
    <Compile Include="..\Editor\Tools\ToolDispatchResult.cs" Link="Source\ToolDispatchResult.cs" />
    <Compile Include="..\Editor\Tools\BridgeToolRegistry.cs" Link="Source\BridgeToolRegistry.cs" />
    <!-- P2.2 — godot_open_mcp_node_find. The pure-managed pieces (NodeData DTO, NodeFindBody
         parser, NodePathNormalizer) are compiled into the binary-less host for off-editor unit
         testing; the editor-only handler (NodeTools.Find / ResolveNode / ToNodeData) is #if TOOLS
         and Godot-API-coupled, so it is verified via the headless Godot smoke / live call path,
         not here. NodeData/NodeFindBody have no #if TOOLS guard so they compile directly; both
         route string escaping through BridgeJson. -->
    <Compile Include="..\Editor\Tools\NodeData.cs" Link="Source\NodeData.cs" />
    <Compile Include="..\Editor\Tools\NodeFindBody.cs" Link="Source\NodeFindBody.cs" />
    <Compile Include="..\Editor\Tools\NodePathNormalizer.cs" Link="Source\NodePathNormalizer.cs" />
    <!-- P2.3 — godot_open_mcp_node_create. The pure-managed NodeCreateBody parser compiles into
         the binary-less host (same hand-rolled scalar-extraction style as NodeFindBody); the
         editor-only handler (NodeTools.Create / SetOwnerRecursive / ApplyTransform) is #if TOOLS
         and ClassDB/EditorInterface-coupled, so it is verified via the headless Godot smoke / live
         call path, not here. -->
    <Compile Include="..\Editor\Tools\NodeCreateBody.cs" Link="Source\NodeCreateBody.cs" />
    <!-- P2.4 — godot_open_mcp_node_modify. The pure-managed NodeModifyBody parser compiles into the
         binary-less host (hand-rolled scalar + string-array + string-map extraction); the
         editor-only handler (NodeTools.Modify / ApplyProperties / TryParseColor) is #if TOOLS and
         EditorInterface/Node-coupled, so it is verified via the headless Godot smoke / live call
         path, not here. The P2.5 handlers (SetParent / Duplicate / Delete) reuse this body type's
         node_path parser and the same ResolvePath helper at the editor boundary. -->
    <Compile Include="..\Editor\Tools\NodeModifyBody.cs" Link="Source\NodeModifyBody.cs" />
    <!-- P2.6 — scene lifecycle tools (scene_open / scene_save / scene_list_opened). The pure-managed
         pieces (SceneSummary DTO, SceneOpenBody + SceneSaveBody parsers) compile into the binary-less
         host (same hand-rolled scalar-extraction style as the node *Body parsers); the editor-only
         handler (SceneTools.Open / Save / ListOpened) is #if TOOLS and EditorInterface-coupled, so it
         is verified via the headless Godot smoke / live call path, not here. SceneTools also owns the
         bridge-tracked dirty flag (MarkEditedSceneDirty) consumed by the NodeTools mutators. -->
    <Compile Include="..\Editor\Tools\SceneSummary.cs" Link="Source\SceneSummary.cs" />
    <Compile Include="..\Editor\Tools\SceneOpenBody.cs" Link="Source\SceneOpenBody.cs" />
    <Compile Include="..\Editor\Tools\SceneSaveBody.cs" Link="Source\SceneSaveBody.cs" />
    <!-- P2.7 — scene data + create tools (scene_get_data / scene_create). The pure-managed
         SceneGetDataBody + SceneCreateBody parsers compile into the binary-less host (same
         hand-rolled scalar-extraction style as the scene lifecycle *Body parsers); the editor-only
         handler (SceneTools.GetData / Create) is #if TOOLS and EditorInterface/ClassDB/ResourceSaver-
         coupled, so it is verified via the headless Godot smoke / live call path, not here. -->
    <Compile Include="..\Editor\Tools\SceneGetDataBody.cs" Link="Source\SceneGetDataBody.cs" />
    <Compile Include="..\Editor\Tools\SceneCreateBody.cs" Link="Source\SceneCreateBody.cs" />
    <!-- P3.5 — gate on mutators. The gate types (GateMode/GateOutcome/DeltaData/GateDispatchResult/
         GatePolicy/GateDefaultPolicy) and the VerifyGateAdapter are pure-managed for the parts the unit
         tests exercise (decision matrix, next-step hints, delta math, gate-mode parsing). GatePolicy
         routes defensive errors through BridgeLog (already linked above); VerifyGateAdapter calls
         VerifyRunner + the verify Core/ types, so the verify source tree is linked below to make the
         adapter compile. The dispatch integration test installs GatePolicy.SetExecuteForTests so the
         checkpoint→validate→delta cycle is stubbed — no live verify rules run, so the binary-less host
         never touches ResourceLoader/EditorInterface. -->
    <Compile Include="..\Editor\Gate\GateDefaultPolicy.cs" Link="Source\Gate\GateDefaultPolicy.cs" />
    <Compile Include="..\Editor\Gate\GatePolicy.cs" Link="Source\Gate\GatePolicy.cs" />
    <Compile Include="..\Editor\Gate\VerifyGateAdapter.cs" Link="Source\Gate\VerifyGateAdapter.cs" />
    <!-- P3.6 — gate meta-tools (validate_edit / checkpoint_create / delta). The CheckpointStore +
         CheckpointStoreEntry + GateTools registration are pure-managed (Dictionary/list math, no Godot
         APIs) and compile into the binary-less host. The three MetaTools (ValidateEditTool /
         CheckpointCreateTool / DeltaTool) read body fields via JsonBody (linked above) and call
         VerifyGateAdapter (linked above) + FixProviderRegistry (linked below); their JSON builders are
         pure string assembly. The VerifyGateAdapter call paths that touch VerifyRunner / live Godot APIs
         are not reached by the JSON-builder tests, which inject synthetic VerifyResult / CheckpointStore
         state — so the binary-less host never faults. -->
    <Compile Include="..\Editor\Gate\CheckpointStore.cs" Link="Source\Gate\CheckpointStore.cs" />
    <Compile Include="..\Editor\MetaTools\GateTools.cs" Link="Source\MetaTools\GateTools.cs" />
    <Compile Include="..\Editor\MetaTools\ValidateEditTool.cs" Link="Source\MetaTools\ValidateEditTool.cs" />
    <Compile Include="..\Editor\MetaTools\CheckpointCreateTool.cs" Link="Source\MetaTools\CheckpointCreateTool.cs" />
    <Compile Include="..\Editor\MetaTools\DeltaTool.cs" Link="Source\MetaTools\DeltaTool.cs" />
    <!-- Verify package sources (the bridge depends on verify — packages/verify/AGENTS.md). Linked here
         so VerifyGateAdapter + GatePolicy compile against the real contract types. TOOLS is defined
         above so the #if TOOLS guard on VerifyRunner/VerifyLog/LiveResourceResolver/LiveImportHealthResolver
         compiles; none of their Godot-API call paths execute in tests (the dispatch test stubs the gate,
         and the VerifyGateAdapter/ComputeDelta test only exercises pure types). -->
    <Compile Include="..\..\verify\Editor\Core\VerifyRunMode.cs" Link="Source\Verify\Core\VerifyRunMode.cs" />
    <Compile Include="..\..\verify\Editor\Core\VerifySeverity.cs" Link="Source\Verify\Core\VerifySeverity.cs" />
    <Compile Include="..\..\verify\Editor\Core\VerifyScope.cs" Link="Source\Verify\Core\VerifyScope.cs" />
    <Compile Include="..\..\verify\Editor\Core\VerifyIssue.cs" Link="Source\Verify\Core\VerifyIssue.cs" />
    <Compile Include="..\..\verify\Editor\Core\IssueKey.cs" Link="Source\Verify\Core\IssueKey.cs" />
    <Compile Include="..\..\verify\Editor\Core\IVerifyRule.cs" Link="Source\Verify\Core\IVerifyRule.cs" />
    <Compile Include="..\..\verify\Editor\Core\VerifyResult.cs" Link="Source\Verify\Core\VerifyResult.cs" />
    <Compile Include="..\..\verify\Editor\Core\CheckpointFingerprint.cs" Link="Source\Verify\Core\CheckpointFingerprint.cs" />
    <Compile Include="..\..\verify\Editor\Core\VerifyRunner.cs" Link="Source\Verify\Core\VerifyRunner.cs" />
    <Compile Include="..\..\verify\Editor\VerifyLog.cs" Link="Source\Verify\VerifyLog.cs" />
    <Compile Include="..\..\verify\Editor\Fixes\FixProviderRegistry.cs" Link="Source\Verify\Fixes\FixProviderRegistry.cs" />
    <Compile Include="..\..\verify\Editor\Rules\BrokenReferences\IssueCodes.cs" Link="Source\Verify\Rules\BrokenReferences\IssueCodes.cs" />
    <Compile Include="..\..\verify\Editor\Rules\BrokenReferences\IResourceResolver.cs" Link="Source\Verify\Rules\BrokenReferences\IResourceResolver.cs" />
    <Compile Include="..\..\verify\Editor\Rules\BrokenReferences\LiveResourceResolver.cs" Link="Source\Verify\Rules\BrokenReferences\LiveResourceResolver.cs" />
    <Compile Include="..\..\verify\Editor\Rules\BrokenReferences\SceneRefParser.cs" Link="Source\Verify\Rules\BrokenReferences\SceneRefParser.cs" />
    <Compile Include="..\..\verify\Editor\Rules\BrokenReferences\BrokenReferencesRule.cs" Link="Source\Verify\Rules\BrokenReferences\BrokenReferencesRule.cs" />
    <Compile Include="..\..\verify\Editor\Rules\MissingScripts\IssueCodes.cs" Link="Source\Verify\Rules\MissingScripts\IssueCodes.cs" />
    <Compile Include="..\..\verify\Editor\Rules\MissingScripts\NodeScriptScanner.cs" Link="Source\Verify\Rules\MissingScripts\NodeScriptScanner.cs" />
    <Compile Include="..\..\verify\Editor\Rules\MissingScripts\MissingScriptsRule.cs" Link="Source\Verify\Rules\MissingScripts\MissingScriptsRule.cs" />
    <Compile Include="..\..\verify\Editor\Rules\ImportHealth\IssueCodes.cs" Link="Source\Verify\Rules\ImportHealth\IssueCodes.cs" />
    <Compile Include="..\..\verify\Editor\Rules\ImportHealth\ImportFileParser.cs" Link="Source\Verify\Rules\ImportHealth\ImportFileParser.cs" />
    <Compile Include="..\..\verify\Editor\Rules\ImportHealth\IImportHealthResolver.cs" Link="Source\Verify\Rules\ImportHealth\IImportHealthResolver.cs" />
    <Compile Include="..\..\verify\Editor\Rules\ImportHealth\LiveImportHealthResolver.cs" Link="Source\Verify\Rules\ImportHealth\LiveImportHealthResolver.cs" />
    <Compile Include="..\..\verify\Editor\Rules\ImportHealth\ImportHealthRule.cs" Link="Source\Verify\Rules\ImportHealth\ImportHealthRule.cs" />
  </ItemGroup>

</Project>
