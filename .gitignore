/specs/

# ZCode local session state (plans, scratch)
.zcode/

# Node / TypeScript
node_modules/
dist/
dist-test/
*.tsbuildinfo

# Godot
.godot/
demo/.godot/
*.import
*.uid
# Exception: the demo ships intentional broken-import fixtures under
# demo/Fixtures/ImportHealth/ that the import_health verify rule keys on.
# These ARE tracked source — never ignore them. The patterns above still
# exclude real imported-asset sidecars everywhere else in the tree.
!demo/Fixtures/ImportHealth/*.import

# Demo integration fixture — generated addon tree, build output, scratch.
# The addon is materialized by scripts/prepare-demo-addon.mjs; .godot/ holds
# editor cache; .mono/ + mono/ hold Godot's C# state; bin/ + obj/ are .NET
# build output (the global bin/ and obj/ rules above already exclude these,
# repeated here for clarity under demo/); .godot-open-mcp/ holds bridge
# project-local settings scratch; SmokeScratch/ is the smoke mutation target.
demo/addons/
demo/.mono/
demo/mono/
demo/bin/
demo/obj/
demo/.godot-open-mcp/
demo/SmokeScratch/
demo/*.sln
demo/*.userprefs

# Validation Suite (operator state + disposable staged fixtures). The suite
# scopes everything under the target project: disposable fixtures under
# _ValidationSuite/<test-id>/ and operator state under
# .godot-open-mcp/ValidationSuite/ (the latter already covered by the
# demo/.godot-open-mcp/ rule above; the fixture root is listed explicitly).
demo/_ValidationSuite/

# .NET / C#
bin/
obj/
*.user
*.suo
*.userprefs

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*~

# Build artifacts
*.log
